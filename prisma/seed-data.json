							"title": "Sear",
							"minutes": 4,
							"text": "Sear the prawns and zucchini in olive oil, then set aside."
						},
						{
							"title": "Cream sauce",
							"minutes": 8,
							"text": "Sweat the onion and garlic, deglaze with wine, add the cream, shell reduction and thyme, and simmer."
						},
						{
							"title": "Gnocchi & finish",
							"minutes": 5,
							"text": "Boil the gnocchi until they float, fold into the sauce with the spinach purée, Parmigiano and butter. Top with prawns, lemon zest and parsley."
						}
					]
				}
